<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
    <style>
      body {
        font-family: Arial, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .header {
        background-color: #2C3E50;
        color: white;
        padding: 20px;
        text-align: center;
        border-radius: 5px 5px 0 0;
      }
      .content {
        background-color: #f9f9f9;
        padding: 30px;
        border: 1px solid #ddd;
        border-radius: 0 0 5px 5px;
      }
      .property-info {
        background-color: white;
        padding: 15px;
        margin: 20px 0;
        border-left: 4px solid #27AE60;
        border-radius: 3px;
      }
      .property-title {
        font-size: 18px;
        font-weight: bold;
        color: #2C3E50;
        margin-bottom: 5px;
      }
      .property-price {
        font-size: 20px;
        color: #27AE60;
        font-weight: bold;
      }
      .message {
        background-color: #E8F8F5;
        padding: 15px;
        margin: 15px 0;
        border-radius: 3px;
        font-style: italic;
      }
      .contact-info {
        background-color: white;
        padding: 15px;
        margin: 20px 0;
        border-radius: 3px;
      }
      .contact-info p {
        margin: 5px 0;
      }
      .footer {
        text-align: center;
        margin-top: 30px;
        color: #777;
        font-size: 12px;
      }
    </style>
  </head>
  <body>
    <div class="header">
      <h1>PROPERLIA</h1>
    </div>

    <div class="content">
      <p><%= @t[:greeting] %></p>

      <p><%= @t[:intro] %></p>

      <div class="property-info">
        <div class="property-title"><%= @property.title %></div>
        <div class="property-price">$<%= number_with_delimiter(@property.price, delimiter: ',') %></div>
        <% if @property.address.present? %>
          <p style="margin: 10px 0 0 0; color: #666;"><%= @property.address %></p>
        <% end %>
      </div>

      <% if @message.present? %>
        <div class="message">
          <%= simple_format(@message) %>
        </div>
      <% end %>

      <p><%= @t[:attached] %></p>

      <div class="contact-info">
        <p><strong><%= @t[:contact] %></strong></p>
        <p><strong><%= @t[:phone] %>:</strong> <%= @general_info.phone %></p>
        <p><strong><%= @t[:whatsapp] %>:</strong> <%= @general_info.whatsapp %></p>
        <p><strong><%= @t[:email] %>:</strong> <%= @general_info.email_to %></p>
      </div>

      <p><%= @t[:regards] %><br><%= @t[:team] %></p>
    </div>

    <div class="footer">
      <p>&copy; <%= Time.now.year %> Properlia. All rights reserved.</p>
    </div>
  </body>
</html>
